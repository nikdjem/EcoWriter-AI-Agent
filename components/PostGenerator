
import React, { useState } from 'react';
import { generateBlogPost } from '../services/geminiService';
import { BlogPost, TopicCategory, PostStatus, PostLength, CTAType } from '../types';

const PostGenerator: React.FC = () => {
  const [isGenerating, setIsGenerating] = useState(false);
  const [currentPost, setCurrentPost] = useState<BlogPost | null>(null);
  const [category, setCategory] = useState<TopicCategory>(TopicCategory.WASTE_MANAGEMENT);
  const [tone, setTone] = useState('Professional');
  const [length, setLength] = useState<PostLength>(PostLength.MEDIUM);
  const [cta, setCta] = useState<CTAType>(CTAType.LEARN_MORE);

  const handleGenerate = async () => {
    setIsGenerating(true);
    try {
      const post = await generateBlogPost(
        category, 
        tone, 
        "Industrial engineers and environmental consultants",
        length,
        cta
      );
      setCurrentPost(post);
    } catch (error) {
      console.error("Failed to generate post:", error);
      alert("Error generating post. Please try again.");
    } finally {
      setIsGenerating(false);
    }
  };

  const handlePublish = () => {
    if (!currentPost) return;
    alert(`Post "${currentPost.title}" would be published to your website now!`);
    setCurrentPost(null);
  };

  return (
    <div className="max-w-4xl mx-auto space-y-8 animate-fadeIn pb-20">
      <header className="space-y-6">
        <div>
          <h2 className="text-3xl font-serif text-slate-900">Content Engine</h2>
          <p className="text-slate-500 text-sm">Deep-reasoning AI drafting your next impact story.</p>
        </div>
        
        <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 bg-white p-4 rounded-2xl border border-slate-100 shadow-sm">
          <div className="space-y-1">
            <label className="text-[10px] uppercase font-bold text-slate-400 px-1">Topic</label>
            <select 
              value={category}
              onChange={(e) => setCategory(e.target.value as TopicCategory)}
              className="w-full px-3 py-2 rounded-lg bg-slate-50 border border-slate-200 text-sm font-medium focus:ring-2 focus:ring-emerald-500 outline-none"
            >
              {Object.values(TopicCategory).map(cat => (
                <option key={cat} value={cat}>{cat}</option>
              ))}
            </select>
          </div>

          <div className="space-y-1">
            <label className="text-[10px] uppercase font-bold text-slate-400 px-1">Tone</label>
            <select 
              value={tone}
              onChange={(e) => setTone(e.target.value)}
              className="w-full px-3 py-2 rounded-lg bg-slate-50 border border-slate-200 text-sm font-medium focus:ring-2 focus:ring-emerald-500 outline-none"
            >
              <option>Professional</option>
              <option>Technical</option>
              <option>Educational</option>
              <option>Advocacy</option>
            </select>
          </div>

          <div className="space-y-1">
            <label className="text-[10px] uppercase font-bold text-slate-400 px-1">Length</label>
            <select 
              value={length}
              onChange={(e) => setLength(e.target.value as PostLength)}
              className="w-full px-3 py-2 rounded-lg bg-slate-50 border border-slate-200 text-sm font-medium focus:ring-2 focus:ring-emerald-500 outline-none"
            >
              {Object.values(PostLength).map(l => (
                <option key={l} value={l}>{l}</option>
              ))}
            </select>
          </div>

          <div className="space-y-1">
            <label className="text-[10px] uppercase font-bold text-slate-400 px-1">CTA Type</label>
            <select 
              value={cta}
              onChange={(e) => setCta(e.target.value as CTAType)}
              className="w-full px-3 py-2 rounded-lg bg-slate-50 border border-slate-200 text-sm font-medium focus:ring-2 focus:ring-emerald-500 outline-none"
            >
              {Object.values(CTAType).map(c => (
                <option key={c} value={c}>{c}</option>
              ))}
            </select>
          </div>
        </div>

        <div className="flex justify-center">
          <button
            onClick={handleGenerate}
            disabled={isGenerating}
            className={`flex items-center gap-2 px-12 py-3 rounded-2xl font-bold transition-all ${
              isGenerating 
                ? 'bg-slate-100 text-slate-400 cursor-not-allowed' 
                : 'bg-emerald-600 text-white hover:bg-emerald-700 shadow-xl shadow-emerald-200 hover:scale-[1.02]'
            }`}
          >
            {isGenerating ? (
              <>
                <div className="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
                Thinking...
              </>
            ) : 'Generate Post ✨'}
          </button>
        </div>
      </header>

      {isGenerating && (
        <div className="bg-white rounded-3xl p-16 text-center border-2 border-dashed border-emerald-200">
          <div className="w-20 h-20 bg-emerald-50 rounded-full flex items-center justify-center mx-auto mb-8 relative">
             <div className="absolute inset-0 border-4 border-emerald-500 border-t-transparent rounded-full animate-spin"></div>
             <span className="text-3xl animate-pulse">🧠</span>
          </div>
          <h3 className="text-2xl font-bold text-slate-900">Activating Reasoning Engine</h3>
          <p className="text-slate-500 mt-4 max-w-lg mx-auto leading-relaxed">
            The AI is performing deep analysis on current industry standards and environmental regulations to ensure your <strong>{length}</strong> post on <strong>{category}</strong> is factually sound and engaging.
          </p>
          <div className="mt-8 flex justify-center gap-1">
            <div className="w-1.5 h-1.5 bg-emerald-400 rounded-full animate-bounce [animation-delay:-0.3s]"></div>
            <div className="w-1.5 h-1.5 bg-emerald-400 rounded-full animate-bounce [animation-delay:-0.15s]"></div>
            <div className="w-1.5 h-1.5 bg-emerald-400 rounded-full animate-bounce"></div>
          </div>
        </div>
      )}

      {!isGenerating && currentPost && (
        <div className="space-y-6">
          <div className="bg-white p-10 rounded-3xl shadow-sm border border-slate-100">
            <div className="flex justify-between items-start mb-8">
              <div className="flex gap-2">
                <span className="bg-emerald-50 text-emerald-700 px-3 py-1 rounded-full text-[10px] font-bold tracking-wider uppercase">
                  {currentPost.category}
                </span>
                <span className="bg-slate-50 text-slate-600 px-3 py-1 rounded-full text-[10px] font-bold tracking-wider uppercase">
                  {cta}
                </span>
              </div>
              <div className="flex gap-2 text-slate-400 text-sm">
                <span>⏱️ {currentPost.readingTime} min read</span>
                <span>•</span>
                <span>📅 Drafted with Deep Reason</span>
              </div>
            </div>
            
            <h3 className="text-4xl font-serif text-slate-900 mb-8 leading-tight">{currentPost.title}</h3>
            
            <div className="prose prose-slate max-w-none">
              <div className="bg-slate-50 p-6 rounded-2xl mb-10 border border-slate-100 italic">
                <p className="text-sm font-bold text-slate-400 uppercase mb-2">Meta Description (SEO)</p>
                <p className="text-slate-600 leading-relaxed">
                  {currentPost.excerpt}
                </p>
              </div>
              
              <div className="whitespace-pre-wrap text-slate-700 leading-relaxed text-lg">
                {currentPost.content}
              </div>
            </div>

            <div className="mt-12 pt-8 border-t border-slate-100">
              <p className="text-sm font-bold text-slate-900 mb-4">Semantic Keywords</p>
              <div className="flex flex-wrap gap-2">
                {currentPost.keywords.map(kw => (
                  <span key={kw} className="bg-slate-50 text-slate-600 px-4 py-1.5 rounded-xl text-xs font-medium border border-slate-100 hover:border-emerald-200 transition-colors cursor-default">
                    {kw}
                  </span>
                ))}
              </div>
            </div>
          </div>

          <div className="flex justify-end gap-4 bg-white/80 p-6 rounded-3xl sticky bottom-8 border border-slate-200/50 shadow-2xl backdrop-blur-xl z-10">
            <button 
              onClick={() => setCurrentPost(null)}
              className="px-6 py-3 rounded-2xl font-bold text-slate-500 hover:bg-slate-100 transition-colors"
            >
              Start Over
            </button>
            <button 
              onClick={handlePublish}
              className="px-10 py-3 rounded-2xl font-bold bg-slate-900 text-white hover:bg-slate-800 shadow-xl transition-all hover:scale-[1.02] active:scale-95"
            >
              Approve & Schedule Post
            </button>
          </div>
        </div>
      )}

      {!isGenerating && !currentPost && (
        <div className="bg-white rounded-[2.5rem] p-24 text-center border border-slate-100 shadow-sm">
          <div className="w-24 h-24 bg-emerald-50 rounded-[2rem] flex items-center justify-center mx-auto mb-8 transform rotate-3">
            <span className="text-4xl">🖋️</span>
          </div>
          <h3 className="text-2xl font-bold text-slate-900">Tailor your industrial content</h3>
          <p className="text-slate-500 mt-3 max-w-sm mx-auto leading-relaxed">
            Adjust the length and call-to-action above. The AI will use extended reasoning to ensure your technical details are flawless.
          </p>
        </div>
      )}
    </div>
  );
};

export default PostGenerator;
